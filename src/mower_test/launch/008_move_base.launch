<launch>

  <node name="move_base_flex" pkg="mbf_costmap_nav" type="mbf_costmap_nav" required="true" output="screen">
    <remap from="cmd_vel" to="/nav_vel"/>
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/local_costmap_params.yaml" command="load" />
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/global_costmap_params.yaml" command="load" />
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/move_base_flex.yaml" command="load"/>
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/ftc_local_planner.yaml" command="load" />
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/docking_ftc_local_planner.yaml" command="load" />
    <rosparam file="/opt/open_mower_ros/src/mower_params/map/global_planner_params.yaml" command="load" />
  </node>

  <node name="move_base_legacy_relay" pkg="mbf_costmap_nav" type="move_base_legacy_relay.py">
    <param name="base_local_planner" value="FTCPlanner" />
    <param name="base_global_planner" value="GlobalPlanner" />
  </node>

</launch>

<!-- 全局和局部规划器，单独运行这个会报错 -->
