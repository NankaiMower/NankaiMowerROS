\subsubsection usage Usage
\verbatim
<node name="ftc_local_planner" pkg="ftc_local_planner" type="ftc_local_planner">
  <param name="speed_fast" type="double" value="0.5" />
  <param name="speed_fast_threshold" type="double" value="1.5" />
  <param name="speed_fast_threshold_angle" type="double" value="5.0" />
  <param name="speed_slow" type="double" value="0.2" />
  <param name="speed_angular" type="double" value="20.0" />
  <param name="acceleration" type="double" value="1.0" />
  <param name="kp_lon" type="double" value="1.0" />
  <param name="ki_lon" type="double" value="0.0" />
  <param name="ki_lon_max" type="double" value="10.0" />
  <param name="kd_lon" type="double" value="0.0" />
  <param name="ki_lat" type="double" value="0.0" />
  <param name="ki_lat_max" type="double" value="10.0" />
  <param name="kp_lat" type="double" value="1.0" />
  <param name="kd_lat" type="double" value="0.0" />
  <param name="kp_ang" type="double" value="1.0" />
  <param name="ki_ang" type="double" value="0.0" />
  <param name="ki_ang_max" type="double" value="10.0" />
  <param name="kd_ang" type="double" value="0.0" />
  <param name="max_cmd_vel_speed" type="double" value="2.0" />
  <param name="max_cmd_vel_ang" type="double" value="2.0" />
  <param name="max_goal_distance_error" type="double" value="1.0" />
  <param name="max_goal_angle_error" type="double" value="10.0" />
  <param name="goal_timeout" type="double" value="5.0" />
  <param name="max_follow_distance" type="double" value="1.0" />
  <param name="forward_only" type="bool" value="True" />
  <param name="restore_defaults" type="bool" value="False" />
  <param name="debug_pid" type="bool" value="False" />
</node>
\endverbatim

